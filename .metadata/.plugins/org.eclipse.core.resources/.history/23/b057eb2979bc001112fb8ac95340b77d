int main(void) {
    //... (Init phần cứng như bình thường)
    /* USER CODE BEGIN 2 */
    updateClockBuffer();
    HAL_TIM_Base_Start_IT(&htim2);
    setTimer0(1000);
    setTimer1(1000);
    /* USER CODE END 2 */

    while (1) {
        if (timer0_flag == 1) {
            setTimer0(1000);
            second++;
            if (second >= 60) { second = 0; minute++; }
            if (minute >= 60) { minute = 0; hour++; }
            if (hour >= 24) hour = 0;
            updateClockBuffer();
        }

        if (timer1_flag == 1) {
            setTimer1(1000);
            HAL_GPIO_TogglePin(DOT_GPIO_Port, DOT_Pin);
        }
    }
}

