void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim) {
    if (htim->Instance == TIM2) {
        timer_run();

        // Quét 7 đoạn vẫn ở trong ngắt, chu kỳ 250ms
        led_scan_counter++;
        if (led_scan_counter >= 25) {
            led_scan_counter = 0;
            update7SEG(index_led++);
            if (index_led >= MAX_LED) index_led = 0;
        }
    }
}
