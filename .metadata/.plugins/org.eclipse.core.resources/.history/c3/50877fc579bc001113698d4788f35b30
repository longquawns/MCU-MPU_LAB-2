int main(void) {
    //... (Init phần cứng như bình thường)
    /* USER CODE BEGIN 2 */
    updateClockBuffer();
    HAL_TIM_Base_Start_IT(&htim2);

    setTimer0(1000);
    setTimer1(1000);
    setTimer2(250);  // 250ms cho mỗi LED (tổng 4 LED = 1s = 1Hz)
    /* USER CODE END 2 */

    while (1) {
        if (timer0_flag == 1) {
            setTimer0(1000);
            second++;
            if (second >= 60) { second = 0; minute++; }
            if (minute >= 60) { minute = 0; hour++; }
            if (hour >= 24) hour = 0;
            updateClockBuffer();
        }

        if (timer1_flag == 1) {
            setTimer1(1000);
            HAL_GPIO_TogglePin(DOT_GPIO_Port, DOT_Pin);
        }

        // Bài 8: Việc quét LED 7 đoạn được dời hoàn toàn xuống main
        if (timer2_flag == 1) {
            setTimer2(250);
            update7SEG(index_led++);
            if (index_led >= MAX_LED) index_led = 0;
        }
    }
}

